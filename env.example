# ============================================
# Supabase Edge Functions Environment Variables
# ============================================
# These are set via Supabase Dashboard or `supabase secrets set` command
# For local development, set them in your shell or use supabase CLI

# Coinbase Developer Platform (CDP) API Credentials
# Required for: cdp_create_server_wallet, cdp_get_wallet_balance
# Get these from: https://portal.cdp.coinbase.com/
CDP_API_KEY_ID=your-cdp-api-key-id
CDP_API_KEY_SECRET=your-cdp-api-key-secret
CDP_WALLET_SECRET=your-cdp-wallet-secret

# Alternative naming (also supported):
# COINBASE_API_KEY_ID=your-api-key-id
# COINBASE_API_KEY_SECRET=your-api-key-secret

# Supabase Service Role Key
# Required for: kv_sync_worker
# Get this from: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cloudflare KV Sync (for kv_sync_worker)
# Required for: kv_sync_worker
# Get these from: Cloudflare Dashboard → Workers & Pages → KV
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_KV_API_TOKEN=your-cloudflare-kv-api-token
CLOUDFLARE_KV_NAMESPACE_ID=your-kv-namespace-id

# Optional: Override tenant ID for manual testing
# KV_SYNC_TENANT_ID=optional-tenant-uuid-for-testing

# Circle Faucet API Key (Required)
# Required for: request_usdc_faucet
# Get this from: Circle Developer Console → API & Client Keys
# Sign up at: https://console.circle.com/signup
# Format: authorization: Bearer TEST_API_KEY:your_api_key
CIRCLE_FAUCET_API_KEY=your-circle-faucet-api-key

# Etherscan API Key (Recommended - works for all Etherscan-based explorers)
# Required for: get_wallet_balances, get_wallet_transactions (all EVM chains)
# This single key works across all Etherscan-based explorers:
#   - Base: https://basescan.org/myapikey
#   - Base Sepolia: Same key as Base
#   - Ethereum: https://etherscan.io/myapikey
#   - Arbitrum: https://arbiscan.io/myapikey
#   - Optimism: https://optimistic.etherscan.io/myapikey
#   - Polygon: https://polygonscan.com/myapikey
# Sign up is free and significantly improves rate limits (5 req/sec with free key)
ETHERSCAN_API_KEY=your-etherscan-api-key

# Legacy: Chain-specific keys (optional, used as fallback)
# BASESCAN_API_KEY=your-basescan-api-key

# Solana RPC URL (Optional - only for Solana chain)
# Required for: get_wallet_balances, get_wallet_transactions (Solana only)
# If not set, public RPC endpoint will be used as fallback
# For better performance and rate limits, use services like Helius, QuickNode, or Alchemy
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ============================================
# Cloudflare Worker Environment Variables
# ============================================
# These are set via Wrangler CLI or Cloudflare Dashboard
# Use `wrangler secret put <KEY_NAME>` to set secrets securely

# CDP API Credentials (same as above, but set as secrets in Cloudflare)
# CDP_API_KEY_ID=your-cdp-api-key-id
# CDP_API_KEY_SECRET=your-cdp-api-key-secret

# Optional: Default USDC addresses (fallbacks if not in tenant config)
# EVM_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# SOL_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# ASSET_DECIMALS=6

# ============================================
# Frontend Environment Variables
# ============================================
# For Next.js (web/) and Vite (playground/) apps
# Create .env.local files in each directory

# Supabase Configuration
# Get these from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# For Vite/Playground (if using import.meta.env)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ============================================
# Notes
# ============================================
# 1. Supabase Edge Functions:
#    - Set secrets via: `supabase secrets set KEY_NAME=value`
#    - Or in Supabase Dashboard → Edge Functions → Settings → Secrets
#
# 2. Cloudflare Worker:
#    - Set secrets via: `wrangler secret put KEY_NAME`
#    - Or in Cloudflare Dashboard → Workers → Your Worker → Settings → Variables
#
# 3. Frontend Apps:
#    - Create .env.local files (gitignored)
#    - Use NEXT_PUBLIC_ prefix for Next.js
#    - Use VITE_ prefix for Vite apps
#
# 4. Faucet API Key:
#    - No .env needed - stored in browser localStorage
#    - Configure via UI in the Faucet component

